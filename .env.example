# Copiar este archivo como .env y poner los datos de cada uno
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ticketing
# Solo para bases de datos en internet (ej. Aiven): DB_SSL=true y, si se tiene, el certificado en DB_SSL_CA
# DB_SSL=true
# DB_SSL_CA=

# JWT (autenticacion: lo usan el login y el middleware)
JWT_SECRET=cambiar_esta_clave
JWT_EXPIRA=2h